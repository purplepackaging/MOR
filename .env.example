# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Supabase project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=
# Supabase secret key (sb_secret_...) or legacy service_role key. Server-only.
SUPABASE_SECRET_KEY=

# Supabase publishable key (sb_publishable_...). Used by the client portal on the server.
SUPABASE_PUBLISHABLE_KEY=

# Turns on the client portal ("true" to enable). Needs the three Supabase values above.
NEXT_PUBLIC_PORTAL_ENABLED=false

# Optional. With the portal on, the site shows only items that have a cost in Supabase.
# "true" shows every item again; ones without a price say "To be confirmed". Needs a new deploy.
SHOW_UNPRICED=

# Optional: email the team when a customer places an order or creates an account (Resend).
# A key with sending access to the sending domain is enough.
RESEND_API_KEY=
# The sender must be on a domain verified in Resend, e.g. MOR Supply <orders@mail.morsupply.com>
ORDER_EMAIL_FROM=
# One or more addresses, comma separated.
ORDER_EMAIL_TO=

# Optional: online payments with Stripe (the pay link on each order). All three, or payments stay off.
# Keys from Stripe: Developers > API keys. Test keys (sk_test_, pk_test_) work everywhere but the live site.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# The signing secret of the webhook endpoint https://morsupply.com/api/stripe/webhook (Developers > Webhooks).
STRIPE_WEBHOOK_SECRET=
